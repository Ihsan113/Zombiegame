# Pixel Zombie Online — konfigurasi Node.js + WebSocket
# Setelah diedit, restart server. Port HTTP dan WebSocket adalah SATU port TCP.
API_PORT=2186
API_BIND=0.0.0.0
MAX_ROOMS=12

# URL publik opsional hanya untuk ditampilkan di terminal, bukan membuka port.
# Jika hosting memberikan domain HTTPS, pakai https://... agar game memakai WSS.
# PUBLIC_URL=http://202.155.143.139:2186
# Alternatif jika diperlukan:
# PUBLIC_HOST=202.155.143.139
# PUBLIC_PORT=2186

# Pterodactyl: SERVER_PORT dari panel menang atas API_PORT di file ini.
# Pastikan port yang dipilih adalah port TCP yang dialokasikan oleh hosting.

# IP publik keluar dideteksi via ipify; untuk menonaktifkan pakai 0.
PUBLIC_IP_LOOKUP=1
